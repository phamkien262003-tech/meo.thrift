# Sao chép file này thành .env và điền giá trị thật trước khi chạy

NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
SITE_NAME=teo.mhrift

SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai

# MySQL — bắt buộc. Toàn bộ dữ liệu (sản phẩm, đơn hàng, nội dung, ảnh) sống ở đây thay
# vì file cục bộ, vì Hostinger dựng lại thư mục ứng dụng từ Git mỗi lần deploy, xoá mọi
# thứ không nằm trong database. Lấy thông tin này trong hPanel → MySQL Databases.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Tài khoản quản trị đầu tiên: đặt 2 biến này rồi khởi động/restart app để tự tạo
# (chỉ tạo khi bảng admin_users đang trống — không ghi đè tài khoản đã có).
# Ở local, cũng có thể dùng lệnh: npm run create-admin -- <email> <mat_khau>
ADMIN_EMAIL=admin@teomhrift.vn
ADMIN_BOOTSTRAP_PASSWORD=

# SMTP để gửi email đơn hàng (ví dụ dùng Hostinger email hoặc Gmail App Password)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@teomhrift.vn
SMTP_PASS=
SHOP_NOTIFY_EMAIL=hello@teomhrift.vn

# Thông tin chuyển khoản hiển thị ở bước đặt hàng (Phase 1 - thủ công)
BANK_NAME=Vietcombank
BANK_ACCOUNT_NAME=NGUYEN VAN A
BANK_ACCOUNT_NUMBER=0123456789

# Thông tin liên hệ hiển thị ở chân trang / trang Liên hệ (đều sửa được qua /admin/cai-dat)
CONTACT_EMAIL=hello@teomhrift.vn
CONTACT_PHONE=0900 000 000
CONTACT_ZALO_URL=
CONTACT_INSTAGRAM_HANDLE=@teo.mhrift
CONTACT_INSTAGRAM_URL=
CONTACT_FACEBOOK_URL=
