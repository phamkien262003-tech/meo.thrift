<!doctype html>
<html lang="vi">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/header') %>

<main>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-sand via-cream to-rose/20"></div>
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-olive/10 blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-terracotta/10 blur-3xl"></div>
    <%- include('../partials/leaf-branch', { corner: 'top-left', className: 'hidden xl:block top-0 left-0 w-64 xl:w-80 opacity-80' }) %>
    <%- include('../partials/leaf-branch', { corner: 'bottom-left', className: 'hidden xl:block bottom-0 left-0 w-56 xl:w-72 opacity-70' }) %>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal" data-reveal>
        <span class="badge bg-olive/10 text-olive-dark mb-5"><%- icon('sparkle', 'w-3.5 h-3.5') %> <%- edit('home', 'heroBadge', content.home.heroBadge) %></span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl leading-[1.1] text-espresso mb-6">
          <%- edit('home', 'heroTitleLine1', content.home.heroTitleLine1) %><br />
          <span class="text-terracotta italic"><%- edit('home', 'heroTitleEmphasis', content.home.heroTitleEmphasis) %></span>
        </h1>
        <p class="text-espresso-soft text-lg leading-relaxed mb-8 max-w-md">
          <%- edit('home', 'heroDesc', content.home.heroDesc, { multiline: true }) %>
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/cua-hang" class="btn-primary"><%- edit('home', 'heroCtaPrimary', content.home.heroCtaPrimary) %> <%- icon('chevronRight', 'w-4 h-4') %></a>
          <a href="/ve-chung-toi" class="btn-secondary"><%- edit('home', 'heroCtaSecondary', content.home.heroCtaSecondary) %></a>
        </div>
      </div>
      <div class="relative reveal" data-reveal>
        <%- include('../partials/editable-image', { page: 'home', key: 'heroImage', value: content.home.heroImage, position: content.home.heroImagePosition, tone: 'olive', seed: 1, className: 'relative aspect-[4/5] rounded-organic shadow-soft' }) %>
        <div class="absolute -bottom-6 -left-6 w-32 h-40 hidden sm:block">
          <%- include('../partials/editable-image', { page: 'home', key: 'heroImage2', value: content.home.heroImage2, position: content.home.heroImage2Position, tone: 'rose', seed: 2, className: 'relative w-full h-full rounded-2xl shadow-soft border-4 border-cream' }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- Hook: full-bleed statement image -->
  <section class="relative w-full overflow-hidden reveal" data-reveal>
    <div class="relative aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9] min-h-[300px] sm:min-h-[380px] lg:min-h-[420px] w-full">
      <%- include('../partials/editable-image', { page: 'home', key: 'hookImage', value: content.home.hookImage, position: content.home.hookImagePosition, tone: 'terracotta', seed: 3, className: 'absolute inset-0 w-full h-full' }) %>
      <div class="absolute inset-0 bg-gradient-to-t from-espresso/85 via-espresso/25 to-transparent"></div>
      <div class="absolute inset-0 flex items-end">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 sm:pb-16 w-full text-cream">
          <span class="badge bg-cream/15 text-cream backdrop-blur-sm mb-4"><%- icon('sparkle', 'w-3.5 h-3.5') %> <%- edit('home', 'hookEyebrow', content.home.hookEyebrow) %></span>
          <h2 class="text-3xl sm:text-5xl lg:text-6xl leading-[1.1] mb-3 sm:mb-4 max-w-2xl"><%- edit('home', 'hookTitle', content.home.hookTitle) %></h2>
          <p class="text-cream/85 text-sm sm:text-lg leading-relaxed mb-5 sm:mb-6 max-w-md"><%- edit('home', 'hookDesc', content.home.hookDesc, { multiline: true }) %></p>
          <a href="/cua-hang" class="btn-primary"><%- edit('home', 'hookCta', content.home.hookCta) %> <%- icon('chevronRight', 'w-4 h-4') %></a>
        </div>
      </div>
    </div>
  </section>

  <!-- USP -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid sm:grid-cols-3 gap-8">
    <div class="text-center reveal" data-reveal>
      <div class="w-14 h-14 mx-auto rounded-full bg-terracotta/10 flex items-center justify-center text-terracotta mb-4"><%- icon('leaf', 'w-6 h-6') %></div>
      <h3 class="font-serif text-xl mb-2"><%- edit('home', 'usp1Title', content.home.usp1Title) %></h3>
      <p class="text-sm text-espresso-soft leading-relaxed"><%- edit('home', 'usp1Desc', content.home.usp1Desc, { multiline: true }) %></p>
    </div>
    <div class="text-center reveal" data-reveal>
      <div class="w-14 h-14 mx-auto rounded-full bg-olive/10 flex items-center justify-center text-olive mb-4"><%- icon('sparkle', 'w-6 h-6') %></div>
      <h3 class="font-serif text-xl mb-2"><%- edit('home', 'usp2Title', content.home.usp2Title) %></h3>
      <p class="text-sm text-espresso-soft leading-relaxed"><%- edit('home', 'usp2Desc', content.home.usp2Desc, { multiline: true }) %></p>
    </div>
    <div class="text-center reveal" data-reveal>
      <div class="w-14 h-14 mx-auto rounded-full bg-rose/20 flex items-center justify-center text-terracotta-dark mb-4"><%- icon('heart', 'w-6 h-6') %></div>
      <h3 class="font-serif text-xl mb-2"><%- edit('home', 'usp3Title', content.home.usp3Title) %></h3>
      <p class="text-sm text-espresso-soft leading-relaxed"><%- edit('home', 'usp3Desc', content.home.usp3Desc, { multiline: true }) %></p>
    </div>
  </section>

  <!-- Featured products -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-end justify-between mb-10 reveal" data-reveal>
      <div>
        <p class="text-xs tracking-widest uppercase text-terracotta mb-2"><%- edit('home', 'featuredEyebrow', content.home.featuredEyebrow) %></p>
        <h2 class="text-3xl sm:text-4xl"><%- edit('home', 'featuredTitle', content.home.featuredTitle) %></h2>
      </div>
      <a href="/cua-hang" class="btn-ghost hidden sm:inline-flex">Xem tất cả <%- icon('chevronRight', 'w-4 h-4') %></a>
    </div>
    <% if (featured.length === 0) { %>
      <p class="text-espresso-soft">Chưa có sản phẩm nào. Hãy quay lại sau nhé!</p>
    <% } else { %>
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        <% featured.forEach(product => { %>
          <%- include('../partials/product-card', { product }) %>
        <% }) %>
      </div>
    <% } %>
    <a href="/cua-hang" class="btn-secondary mt-10 sm:hidden w-full">Xem tất cả sản phẩm</a>
  </section>

  <!-- Sold showcase -->
  <% if (sold && sold.length > 0) { %>
    <section class="bg-rose/10 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10 reveal" data-reveal>
          <p class="text-xs tracking-widest uppercase text-terracotta mb-2"><%- edit('home', 'soldEyebrow', content.home.soldEyebrow) %></p>
          <h2 class="text-3xl sm:text-4xl mb-3"><%- edit('home', 'soldTitle', content.home.soldTitle) %></h2>
          <p class="text-espresso-soft max-w-xl mx-auto"><%- edit('home', 'soldDesc', content.home.soldDesc, { multiline: true }) %></p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          <% sold.forEach(product => { %>
            <%- include('../partials/product-card', { product }) %>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Story teaser -->
  <section class="relative overflow-hidden bg-olive/5 py-20">
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal" data-reveal>
      <%- include('../partials/leaf-branch', { corner: 'top-left', className: 'hidden xl:block top-0 -left-48 w-48 opacity-70' }) %>
      <%- include('../partials/leaf-branch', { corner: 'bottom-right', className: 'hidden xl:block bottom-0 -right-48 w-48 opacity-70' }) %>
      <span class="text-olive"><%- icon('leaf', 'w-8 h-8 mx-auto mb-4') %></span>
      <h2 class="text-3xl sm:text-4xl mb-5"><%- edit('home', 'storyTitle', content.home.storyTitle) %></h2>
      <p class="text-espresso-soft leading-relaxed text-lg mb-8">
        <%- edit('home', 'storyBody', content.home.storyBody, { multiline: true }) %>
      </p>
      <a href="/ve-chung-toi" class="btn-primary"><%- edit('home', 'storyCta', content.home.storyCta) %></a>
    </div>
  </section>

  <!-- Journal highlights -->
  <% if (journalPosts && journalPosts.length > 0) { %>
    <section class="bg-sand/40 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-10 reveal" data-reveal>
          <div>
            <p class="text-xs tracking-widest uppercase text-terracotta mb-2"><%- edit('home', 'journalEyebrow', content.home.journalEyebrow) %></p>
            <h2 class="text-3xl sm:text-4xl"><%- edit('home', 'journalTitle', content.home.journalTitle) %></h2>
          </div>
          <a href="/nhat-ky" class="btn-ghost hidden sm:inline-flex">Xem tất cả <%- icon('chevronRight', 'w-4 h-4') %></a>
        </div>
        <div class="grid sm:grid-cols-3 gap-8">
          <% journalPosts.forEach((post, i) => { %>
            <% const jResolved = resolveImage(post.cover_image_id); %>
            <a href="/nhat-ky/<%= post.slug %>" class="group reveal" data-reveal>
              <div class="aspect-[4/3] rounded-2xl overflow-hidden card-surface mb-4">
                <% if (jResolved.isPlaceholder) { %>
                  <%- placeholderArt(post.cover_color, post.id || i) %>
                <% } else { %>
                  <img src="<%= jResolved.src %>" alt="" loading="lazy" class="w-full h-full object-cover" style="object-position: <%= post.cover_image_position || 'center center' %>;" />
                <% } %>
              </div>
              <p class="text-xs text-espresso-soft mb-1"><%= new Date(post.published_at).toLocaleDateString('vi-VN') %></p>
              <h3 class="font-serif text-xl group-hover:text-terracotta transition-colors duration-250"><%= post.title %></h3>
              <p class="text-sm text-espresso-soft mt-2 leading-relaxed line-clamp-2"><%= post.excerpt %></p>
            </a>
          <% }) %>
        </div>
        <a href="/nhat-ky" class="btn-secondary mt-10 sm:hidden w-full block text-center">Xem tất cả bài viết</a>
      </div>
    </section>
  <% } %>

  <!-- Newsletter -->
  <section class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center reveal" data-reveal>
    <%- include('../partials/leaf-branch', { corner: 'top-left', className: 'hidden xl:block top-0 -left-40 w-40 opacity-60' }) %>
    <%- include('../partials/leaf-branch', { corner: 'bottom-right', className: 'hidden xl:block bottom-0 -right-40 w-40 opacity-60' }) %>
    <h2 class="text-2xl sm:text-3xl mb-3"><%- edit('home', 'newsletterTitle', content.home.newsletterTitle) %></h2>
    <p class="text-espresso-soft mb-6"><%- edit('home', 'newsletterDesc', content.home.newsletterDesc, { multiline: true }) %></p>
    <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Đã đăng ký';">
      <input type="email" required placeholder="Email của bạn" class="field-input flex-1" />
      <button type="submit" class="btn-primary whitespace-nowrap">Đăng ký</button>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
<script src="/js/main.js?v=<%= assetVersion %>" defer></script>
<script src="/js/cart.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
