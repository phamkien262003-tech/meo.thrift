{
  "name": "teo-mhrift",
  "version": "1.0.0",
  "private": true,
  "description": "teo.mhrift — cửa hàng váy secondhand cao cấp, chỉ bán online",
  "main": "app.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch app.js",
    "start": "node app.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "create-admin": "node src/db/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "session-file-store": "^1.5.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "tailwindcss": "^3.4.10"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
