<!doctype html>
<html lang="vi">
<head>
<%- include('../partials/head') %>
</head>
<body class="bg-cream">
<%- include('../partials/admin-nav') %>

  <a href="/admin/noi-dung" class="btn-ghost mb-4"><%- icon('chevronLeft', 'w-4 h-4') %> Quay lại danh sách</a>
  <%- include('../partials/flash') %>
  <h1 class="text-3xl mb-8"><%= schema.label %></h1>

  <form action="/admin/noi-dung/<%= page %>" method="POST" class="space-y-6 max-w-2xl">
    <% schema.groups.forEach(group => { %>
      <div class="card-surface p-6 space-y-4">
        <h2 class="font-serif text-xl mb-2"><%= group.title %></h2>
        <% group.fields.filter(f => f.type !== 'image' && f.type !== 'imagePosition').forEach(field => { %>
          <div>
            <label class="field-label" for="field-<%= field.key %>"><%= field.label %></label>
            <% if (field.type === 'textarea') { %>
              <textarea id="field-<%= field.key %>" name="<%= field.key %>" rows="3" class="field-input"><%= values[field.key] %></textarea>
            <% } else { %>
              <input type="text" id="field-<%= field.key %>" name="<%= field.key %>" value="<%= values[field.key] %>" class="field-input" />
            <% } %>
          </div>
        <% }) %>
        <% if (group.fields.every(f => f.type === 'image' || f.type === 'imagePosition')) { %>
          <p class="text-sm text-espresso-soft">Ảnh và vị trí hiển thị được chỉnh trực tiếp trên trang thật — xem trang này để đổi.</p>
        <% } %>
      </div>
    <% }) %>
    <button type="submit" class="btn-primary">Lưu nội dung</button>
  </form>

<%- include('../partials/admin-nav-end') %>
</body>
</html>
