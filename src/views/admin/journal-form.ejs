<!doctype html>
<html lang="vi">
<head>
<%- include('../partials/head') %>
</head>
<body class="bg-cream">
<%- include('../partials/admin-nav') %>

  <a href="/admin/nhat-ky" class="btn-ghost mb-4"><%- icon('chevronLeft', 'w-4 h-4') %> Quay lại danh sách</a>
  <h1 class="text-3xl mb-8"><%= post ? 'Sửa bài viết' : 'Viết bài mới' %></h1>

  <%- include('../partials/flash') %>

  <form action="<%= post ? `/admin/nhat-ky/${post.id}` : '/admin/nhat-ky' %>" method="POST" enctype="multipart/form-data" class="card-surface p-6 space-y-5 mt-4 max-w-2xl">
    <div>
      <label class="field-label" for="title">Tiêu đề <span class="text-terracotta">*</span></label>
      <input type="text" id="title" name="title" required value="<%= post ? post.title : '' %>" class="field-input" />
    </div>
    <div>
      <label class="field-label" for="excerpt">Tóm tắt ngắn (hiện ở trang danh sách)</label>
      <textarea id="excerpt" name="excerpt" rows="2" class="field-input"><%= post ? (post.excerpt || '') : '' %></textarea>
    </div>
    <div>
      <label class="field-label" for="content">Nội dung bài viết</label>
      <textarea id="content" name="content" rows="8" class="field-input"><%= post ? (post.content || '') : '' %></textarea>
    </div>
    <div>
      <label class="field-label" for="cover_image">Ảnh bìa (JPG/PNG/WEBP)</label>
      <input type="file" id="cover_image" name="cover_image" accept="image/jpeg,image/png,image/webp" class="field-input" />
      <% if (post && post.cover_image_id) { %>
        <p class="text-xs text-espresso-soft mt-2">Tải ảnh mới sẽ thay thế ảnh bìa hiện tại.</p>
      <% } %>
    </div>
    <div class="flex gap-3 pt-4 border-t border-border">
      <button type="submit" class="btn-primary"><%= post ? 'Lưu thay đổi' : 'Đăng bài' %></button>
      <a href="/admin/nhat-ky" class="btn-secondary">Hủy</a>
    </div>
  </form>

<%- include('../partials/admin-nav-end') %>
</body>
</html>
