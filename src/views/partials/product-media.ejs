<%
/* locals: product, variant ('thumb'|'detail'), className, imageIndex (optional) */
const _idx = typeof imageIndex === 'number' ? imageIndex : 0;
const _img = product.images && product.images[_idx] ? product.images[_idx] : null;
const _resolved = resolveImage(_img ? _img.filename : null, variant || 'thumb');
%>
<% if (_resolved.isPlaceholder) { %>
  <div class="relative overflow-hidden <%= className || '' %>">
    <%- placeholderArt(_resolved.tone, product.id + _idx) %>
    <span class="absolute bottom-2 right-2 badge bg-espresso/70 text-cream backdrop-blur-sm">
      Ảnh minh họa
    </span>
  </div>
<% } else { %>
  <img
    src="<%= _resolved.src %>"
    alt="<%= product.name %>"
    loading="lazy"
    class="w-full h-full object-cover <%= className || '' %>"
  />
<% } %>
