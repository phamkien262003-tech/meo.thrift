<%# locals: product %>
<article class="group reveal" data-reveal>
  <a href="/san-pham/<%= product.slug %>" class="block">
    <div class="relative aspect-[4/5] rounded-2xl overflow-hidden card-surface">
      <div class="w-full h-full transition-transform duration-[400ms] group-hover:scale-[1.04]">
        <%- include('product-media', { product, variant: 'thumb', className: 'w-full h-full' }) %>
      </div>
      <% if (product.original_price && product.original_price > product.price) { %>
        <span class="absolute top-3 left-3 badge bg-terracotta text-white">
          -<%= Math.round(100 - (product.price / product.original_price) * 100) %>%
        </span>
      <% } %>
      <button type="button"
        class="wishlist-toggle absolute top-3 right-3 p-2 rounded-full bg-cream/90 hover:bg-cream text-espresso transition-colors duration-250"
        data-product-id="<%= product.id %>" aria-label="Thêm vào yêu thích" aria-pressed="false">
        <%- icon('heart', 'w-4 h-4') %>
      </button>
      <% if (product.status !== 'available') { %>
        <div class="absolute inset-0 bg-espresso/50 flex items-center justify-center">
          <span class="badge bg-cream text-espresso"><%= product.status === 'sold' ? 'Đã bán' : 'Đang giữ chỗ' %></span>
        </div>
      <% } %>
    </div>
    <div class="mt-3 space-y-1">
      <p class="text-xs tracking-wide uppercase text-espresso-soft"><%= product.era_tag || product.category %></p>
      <h3 class="font-serif text-lg leading-snug text-espresso group-hover:text-terracotta transition-colors duration-250"><%= product.name %></h3>
      <div class="flex items-center gap-2">
        <span class="font-medium text-terracotta"><%= formatPrice(product.price) %></span>
        <% if (product.original_price && product.original_price > product.price) { %>
          <span class="text-sm text-espresso-soft/70 line-through"><%= formatPrice(product.original_price) %></span>
        <% } %>
      </div>
      <p class="text-xs text-espresso-soft">Size <%= product.size_label %> · <%= product.condition_grade %></p>
    </div>
  </a>
</article>
