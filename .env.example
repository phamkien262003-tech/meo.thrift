# Sao chép file này thành .env và điền giá trị thật trước khi chạy

NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
SITE_NAME=teo.mhrift

SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai

# Tài khoản quản trị (chạy `npm run create-admin` để tạo/đổi mật khẩu)
ADMIN_EMAIL=admin@teomhrift.vn

# SMTP để gửi email đơn hàng (ví dụ dùng Hostinger email hoặc Gmail App Password)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@teomhrift.vn
SMTP_PASS=
SHOP_NOTIFY_EMAIL=hello@teomhrift.vn

# Thông tin chuyển khoản hiển thị ở bước đặt hàng (Phase 1 - thủ công)
BANK_NAME=Vietcombank
BANK_ACCOUNT_NAME=NGUYEN VAN A
BANK_ACCOUNT_NUMBER=0123456789
