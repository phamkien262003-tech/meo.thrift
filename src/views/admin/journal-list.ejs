<!doctype html>
<html lang="vi">
<head>
<%- include('../partials/head') %>
</head>
<body class="bg-cream">
<%- include('../partials/admin-nav') %>

  <%- include('../partials/flash') %>
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl">Quản lý nhật ký</h1>
    <a href="/admin/nhat-ky/them" class="btn-primary"><%- icon('plus', 'w-4 h-4') %> Viết bài mới</a>
  </div>

  <div class="card-surface overflow-x-auto">
    <table class="w-full text-sm min-w-[560px]">
      <thead>
        <tr class="text-left border-b border-border">
          <th class="py-3 px-4">Ảnh bìa</th>
          <th class="py-3 px-4">Tiêu đề</th>
          <th class="py-3 px-4">Ngày đăng</th>
          <th class="py-3 px-4 text-right">Thao tác</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% if (posts.length === 0) { %>
          <tr><td colspan="4" class="py-8 px-4 text-center text-espresso-soft">Chưa có bài viết nào. <a href="/admin/nhat-ky/them" class="text-terracotta underline">Viết bài đầu tiên</a>.</td></tr>
        <% } %>
        <% posts.forEach(p => { %>
          <% const resolved = resolveImage(p.cover_image_id); %>
          <tr>
            <td class="py-2 px-4">
              <div class="w-12 h-14 rounded-lg overflow-hidden">
                <% if (resolved.isPlaceholder) { %>
                  <%- placeholderArt(p.cover_color, p.id) %>
                <% } else { %>
                  <img src="<%= resolved.src %>" alt="" class="w-full h-full object-cover" />
                <% } %>
              </div>
            </td>
            <td class="py-2 px-4 font-medium"><%= p.title %></td>
            <td class="py-2 px-4 text-espresso-soft"><%= new Date(p.published_at).toLocaleDateString('vi-VN') %></td>
            <td class="py-2 px-4 text-right space-x-3 whitespace-nowrap">
              <a href="/admin/nhat-ky/<%= p.id %>/sua" class="text-espresso-soft hover:text-terracotta inline-flex"><%- icon('pencil', 'w-4 h-4') %></a>
              <form action="/admin/nhat-ky/<%= p.id %>/xoa" method="POST" class="inline" onsubmit="return confirm('Xóa bài viết này?');">
                <button type="submit" class="text-espresso-soft hover:text-red-600 inline-flex"><%- icon('trash', 'w-4 h-4') %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

<%- include('../partials/admin-nav-end') %>
</body>
</html>
