<!doctype html>
<html lang="vi">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/header') %>

<main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <h1 class="text-4xl sm:text-5xl mb-10"><%- edit('policy', 'title', content.policy.title) %></h1>

  <div class="space-y-8 text-espresso-soft leading-relaxed">
    <% [1, 2, 3, 4].forEach(n => { %>
      <div>
        <h2 class="font-serif text-2xl text-espresso mb-3"><%- edit('policy', 'section' + n + 'Title', content.policy['section' + n + 'Title']) %></h2>
        <p><%- edit('policy', 'section' + n + 'Body', content.policy['section' + n + 'Body'], { multiline: true }) %></p>
      </div>
    <% }) %>
  </div>
</main>

<%- include('../partials/footer') %>
<script src="/js/main.js?v=<%= assetVersion %>" defer></script>
<script src="/js/cart.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
