<%
/* Decorative botanical corner image (cropped from the owner's reference illustration) for
   empty background areas — never place over product photos or text. locals:
   corner ('top-left'|'top-right'|'bottom-left'|'bottom-right'), className (position/size
   utility classes, e.g. "-bottom-6 -left-6 w-72"). */
const _corner = ['top-left', 'top-right', 'bottom-left', 'bottom-right'].includes(corner) ? corner : 'top-left';
const _className = typeof className === 'string' ? className : '';
// Real pixel dimensions of each cropped asset, so the browser can reserve layout space
// before the image loads — without this, loading="lazy" never fires (the element has no
// height yet, so it never intersects the viewport) and the image silently never appears.
const _dims = {
  'top-left': [480, 380],
  'top-right': [480, 380],
  'bottom-left': [460, 420],
  'bottom-right': [280, 230],
}[_corner];
%>
<%# Not loading="lazy" — these small (~20KB) decorative images sit at 0-height until their
    intrinsic size is known, which some browsers/automation contexts never resolve as "near
    viewport", so lazy-loading silently never fires them at all. Load eagerly instead. %>
<img aria-hidden="true" alt="" src="/images/bg-leaf-<%= _corner %>.webp?v=<%= assetVersion %>" width="<%= _dims[0] %>" height="<%= _dims[1] %>" style="aspect-ratio: <%= _dims[0] %> / <%= _dims[1] %>;" class="pointer-events-none select-none absolute h-auto <%= _className %>" />
